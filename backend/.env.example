# Copy this file to .env and change the values

# PostgreSQL connection: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrms_master

# Secret key used to sign login tokens (change this to any long random text)
SECRET_KEY=change-this-to-a-long-random-secret

# How long a login token is valid (minutes). 1440 = 1 day
TOKEN_EXPIRE_MINUTES=1440

# Send renewal reminder when subscription expires within this many days
RENEWAL_REMINDER_DAYS=7
